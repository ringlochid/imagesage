---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url, STORE_URL } from '../lib/site';

/* Raw 16:9 app captures, not the promo cards. The cards had headlines baked in
   and cropped to 2.26:1, which read short beside a text column. */
import shotLibrary from '../assets/shots/gallery.png';
import shotRename from '../assets/shots/magic-rename.png';
import shotAct from '../assets/shots/select-actions.png';

/* Approved Store short description, quoted verbatim — US spelling intentional. */
const SHORT_DESCRIPTION =
  'A private, local AI gallery. Find any photo by what it shows or the words inside it, then let AI rename it.';
---

<BaseLayout
  title="ImageSage — Find the image you remember"
  description={SHORT_DESCRIPTION}
>
  <main id="content">
    <!-- 1 · Hero -->
    <section class="hero shell">
      <div class="hero-text">
        <h1>Find the image you remember.</h1>
        <p class="lead">{SHORT_DESCRIPTION}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={STORE_URL} rel="external">
            Get ImageSage for Windows
          </a>
        </div>
      </div>

      <div class="hero-media reveal">
        <video
          src={url('assets/trailer.mp4')}
          poster={url('assets/trailer-poster.jpg')}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="ImageSage searching a photo library by description and renaming the results"
        ></video>
      </div>
    </section>

    <hr class="rule shell" />

    <!-- 2 · The three searches -->
    <section class="section shell">
      <div class="feature reverse">
        <div class="feature-text reveal">
          <p class="section-label">Three ways to look</p>
          <h2>Not one clever search. Three different ones.</h2>
          <ul class="feature-list">
            <li><strong>Name and path</strong> — filenames, folders, dates and formats, across every folder you have added at once.</li>
            <li><strong>Words inside the image</strong> — on-device OCR makes a receipt or a slide findable by what it actually says.</li>
            <li><strong>Visual meaning</strong> — describe the picture in plain words; no tags to maintain, no albums to curate.</li>
          </ul>
        </div>
        <div class="shot reveal">
          <Image
            src={shotLibrary}
            alt="The ImageSage gallery showing 278 photos in a grid, with a Search in Gallery box above and a sidebar listing Gallery, Smart collections and the folders My Pictures, animals and photos."
            widths={[720, 1080, 1600]}
            sizes="(min-width: 1160px) 540px, 92vw"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 3 · Magic Rename -->
    <section class="section shell">
      <div class="feature">
        <div class="feature-text reveal">
          <p class="section-label">Magic Rename</p>
          <h2>A generated name is a suggestion until you say otherwise.</h2>
          <p>
            Point Magic Rename at a set of images and it proposes a short, descriptive filename for
            each one.
          </p>
          <ul class="feature-list">
            <li>Every proposal lands in an <strong>editable review list</strong>.</li>
            <li>Nothing on disk changes until you <strong>confirm</strong>.</li>
            <li>The model is packaged with the app and runs on your machine.</li>
          </ul>
          <p style="margin-top:1.5rem">
            <a class="text-link" href={url('ai-transparency.html')}>
              Read the AI transparency note <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
        <div class="shot reveal">
          <Image
            src={shotRename}
            alt="The Magic rename dialog: four files, each with an editable generated filename beside its thumbnail, under the note that names are generated locally by AI and should be reviewed before applying, with Rename 4 files and Cancel buttons at the foot."
            widths={[720, 1080, 1600]}
            sizes="(min-width: 1160px) 540px, 92vw"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 4 · Act on what you found -->
    <section class="section shell">
      <div class="feature reverse">
        <div class="feature-text reveal">
          <p class="section-label">Act on the results</p>
          <h2>Finding the images is only half of it.</h2>
          <p>A result set is a working selection, not a dead end.</p>
          <ul class="feature-list">
            <li>Move, copy, rename or recycle the whole selection in one pass.</li>
            <li>Runs against <strong>original files in place</strong> — indexing never moves or rewrites anything on its own.</li>
            <li>Save a search you keep repeating as a <strong>Smart Collection</strong>.</li>
          </ul>
        </div>
        <div class="shot reveal">
          <Image
            src={shotAct}
            alt="An ImageSage result set for the search “tiger looking out from a window” with four items selected and a command bar offering Cancel, Magic rename, Delete and Move or copy across the whole selection."
            widths={[720, 1080, 1600]}
            sizes="(min-width: 1160px) 540px, 92vw"
            loading="lazy"
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

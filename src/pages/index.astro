---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { url, STORE_URL } from '../lib/site';

import shotSearch from '../assets/shots/search-results.png';
import shotRename from '../assets/shots/magic-rename.png';
import shotAct from '../assets/shots/select-actions.png';
import trailerPoster from '../assets/trailer-poster.jpg';

const displayPoster = await getImage({ src: trailerPoster, width: 1280, format: 'webp', quality: 75 });

const SHORT_DESCRIPTION =
  'Search local photos by description or text inside images with ImageSage for Windows. Offline AI photo search, on-device OCR and editable filename suggestions.';
const appData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL(url('index.html#app'), Astro.site).href,
  name: 'ImageSage',
  url: new URL(url('index.html'), Astro.site).href,
  description: SHORT_DESCRIPTION,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10 22H2 (build 19045) or Windows 11, x64',
  isAccessibleForFree: true,
  downloadUrl: STORE_URL,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: STORE_URL },
  author: { '@type': 'Person', name: 'Leo Zhang' },
  featureList: ['Offline photo search by description', 'On-device OCR text search', 'Reviewed AI filename suggestions'],
  screenshot: new URL(url('assets/trailer-poster.jpg'), Astro.site).href,
};
---

<BaseLayout
  title="ImageSage — Offline AI Photo Search for Windows"
  description={SHORT_DESCRIPTION}
  structuredData={[appData]}
  preloadImage={displayPoster.src}
>
  <main id="content">
    <section class="hero shell">
      <div class="hero-copy">
        <img
          class="hero-icon"
          src={url('assets/imagesage-icon.svg')}
          alt=""
          width="72"
          height="72"
        />
        <p class="section-label">Offline AI photo search for Windows</p>
        <h1>Find the image you remember.</h1>
        <p class="lead">Search your photos by what they show or the words inside them. ImageSage runs AI search, OCR and filename suggestions on your PC, with no account or photo upload.</p>
        <div class="hero-actions store-badge store-badge-hero">
          <ms-store-badge
            productid="9mt89hd9s6sm"
            productname="ImageSage"
            window-mode="direct"
            theme="dark"
            size="large"
            language="en-us"
            animation="on"
          ></ms-store-badge>
          <noscript>
            <a class="btn btn-primary" href={STORE_URL} rel="external">
              Get ImageSage for Windows
            </a>
          </noscript>
        </div>
        <p class="store-note">Free from Microsoft Store · Windows 10/11</p>
        <a class="store-fallback" href={STORE_URL} rel="external">View ImageSage in Microsoft Store</a>
      </div>

      <div class="hero-media">
        <video
          id="product-demo"
          src={url('assets/trailer.mp4')}
          poster={displayPoster.src}
          muted
          loop
          playsinline
          controls
          width="1280"
          height="720"
          preload="none"
          aria-label="ImageSage searching a photo library by description and renaming the results"
        ></video>
      </div>
    </section>

    <section class="product-story shell">
      <div class="story-grid">
        <div class="story-copy" data-reveal>
          <p class="section-label">Search naturally</p>
          <h2>Search photos by description or text.</h2>
          <p>
            One search box can understand what a photo shows, read words with on-device OCR, or
            narrow the library by name and path.
          </p>
          <div class="capability-row" aria-label="Search types">
            <span>Visual meaning</span>
            <span>Text in images</span>
            <span>Name &amp; path</span>
          </div>
          <a class="text-link story-guide-link" href={url('search-photos-by-description.html')}>How to search by description <span aria-hidden="true">→</span></a>
          <a class="text-link story-guide-link" href={url('search-text-in-screenshots.html')}>Find words inside screenshots <span aria-hidden="true">→</span></a>
        </div>

        <figure class="shot" data-reveal data-reveal-delay="0.06">
          <Image
            src={shotSearch}
            alt="ImageSage showing ten results for the search ‘two people on a beach’ from folders in My Pictures."
            widths={[400, 720, 1080, 1600]}
            sizes="(min-width: 960px) 680px, 94vw"
            loading="lazy"
          />
          <figcaption>A real result set from the ImageSage app.</figcaption>
        </figure>
      </div>
    </section>

    <section class="product-story shell">
      <div class="story-grid story-grid-reverse">
        <div class="story-copy" data-reveal>
          <p class="section-label">Review before applying</p>
          <h2>Rename photos with local AI.</h2>
          <p>
            Magic Rename proposes a concise filename for every selected image. Edit each suggestion,
            review the list, and apply only when it looks right.
          </p>
          <ol class="workflow-steps">
            <li><span>1</span>Select</li>
            <li><span>2</span>Review</li>
            <li><span>3</span>Confirm</li>
          </ol>
          <a class="text-link" href={url('ai-photo-renamer.html')}>
            How to review AI filenames <span aria-hidden="true">→</span>
          </a>
        </div>

        <figure class="shot" data-reveal data-reveal-delay="0.06">
          <Image
            src={shotRename}
            alt="The ImageSage Magic rename dialog showing four editable AI-suggested filenames, with Rename 4 files and Cancel buttons."
            widths={[400, 720, 1080, 1600]}
            sizes="(min-width: 960px) 680px, 94vw"
            loading="lazy"
          />
          <figcaption>Suggested filenames remain editable until you confirm.</figcaption>
        </figure>
      </div>
    </section>

    <section class="product-story shell">
      <div class="story-grid">
        <div class="story-copy" data-reveal>
          <p class="section-label">Act on the results</p>
          <h2>Select, move, copy, rename or delete.</h2>
          <p>
            A result set is ready to work with. Select the images you need and perform a file action
            without leaving the search; indexing never moves originals on its own.
          </p>
          <div class="capability-row" aria-label="File actions">
            <span>Move or copy</span>
            <span>Delete</span>
            <span>Work in place</span>
          </div>
        </div>

        <figure class="shot" data-reveal data-reveal-delay="0.06">
          <Image
            src={shotAct}
            alt="An ImageSage result set for ‘tiger looking out from a window’ with four images selected and commands for Magic rename, Delete and Move or copy."
            widths={[400, 720, 1080, 1600]}
            sizes="(min-width: 960px) 680px, 94vw"
            loading="lazy"
          />
          <figcaption>Actions operate on the selected original files.</figcaption>
        </figure>
      </div>
    </section>

    <section class="guide-section shell" aria-labelledby="guides-heading">
      <p class="section-label">Start with what you remember</p>
      <h2 id="guides-heading">Three ways to find and organise your images.</h2>
      <GuideLinks />
    </section>

    <section class="faq-section shell" aria-labelledby="questions-heading">
      <div>
        <p class="section-label">Before you download</p>
        <h2 id="questions-heading">ImageSage questions, answered.</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>Is ImageSage free?</summary>
          <p>Yes. ImageSage is free from Microsoft Store and does not require an ImageSage account.</p>
        </details>
        <details>
          <summary>Can I search my photos offline?</summary>
          <p>Yes. Indexing, OCR, visual search and Magic Rename run on your PC using packaged models. Installing and updating through Microsoft Store requires a connection. Your photo library and searches are not uploaded to the developer. Read the <a href={url('privacy.html')}>privacy policy</a>.</p>
        </details>
        <details>
          <summary>Which Windows versions and image formats are supported?</summary>
          <p>ImageSage supports Windows 10 22H2 (build 19045) and Windows 11 on x64 devices. It reads local PNG, JPEG and WebP images. RAW, HEIC and video files are not part of that supported format set.</p>
        </details>
        <details>
          <summary>Can I find text inside screenshots?</summary>
          <p>Yes. On-device OCR makes recognised words searchable. Let OCR preparation finish, then search for the words or use quotes for an exact recognised phrase. Follow the <a href={url('search-text-in-screenshots.html')}>screenshot search guide</a>.</p>
        </details>
        <details>
          <summary>Does importing a folder move or rename my files?</summary>
          <p>No. Indexing reads your selected folders in place. File actions such as move, copy, delete and rename happen when you request them. Magic Rename shows editable suggestions and only applies the names you confirm.</p>
        </details>
        <details>
          <summary>Why are some search results missing?</summary>
          <p>Check that the folder is included and search preparation has finished. OCR can misread text and visual matching is approximate, so try a shorter phrase or a different description. Visit <a href={url('support.html')}>support and troubleshooting</a> for preparation issues.</p>
        </details>
      </div>
    </section>

    <section class="principles shell" aria-label="ImageSage privacy principles" data-reveal>
      <p class="section-label">Private by design</p>
      <h2>No account. On-device AI. You stay in control.</h2>
      <div class="store-badge store-badge-closing">
        <ms-store-badge
          productid="9mt89hd9s6sm"
          productname="ImageSage"
          window-mode="direct"
          theme="dark"
          size="large"
          language="en-us"
          animation="on"
        ></ms-store-badge>
        <noscript>
          <a class="btn btn-primary" href={STORE_URL} rel="external">
            Get ImageSage for Windows
          </a>
        </noscript>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLVideoElement>('#product-demo');
  const autoplayAllowed = window.matchMedia('(min-width: 60rem) and (prefers-reduced-motion: no-preference)');
  const updatePlayback = () => {
    if (!demo) return;
    if (autoplayAllowed.matches) {
      void demo.play().catch(() => { /* Native controls remain available if autoplay is blocked. */ });
    } else {
      demo.pause();
    }
  };
  updatePlayback();
  autoplayAllowed.addEventListener('change', updatePlayback);
</script>

<script
  is:inline
  type="module"
  src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"
></script>

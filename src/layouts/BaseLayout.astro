---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Filename of this page, e.g. "privacy.html", so the nav can mark itself. */
  current?: string;
  structuredData?: Record<string, unknown>[];
  preloadPoster?: boolean;
}
const { title, description, current, structuredData = [], preloadPoster = false } = Astro.props;
const canonical = new URL(url(current ?? 'index.html'), Astro.site);
// Reuse the existing, unmodified trailer still for previews.
const socialImage = new URL(url('assets/trailer-poster.jpg'), Astro.site);
const pageData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: 'en-GB',
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {!current && <meta name="google-site-verification" content="koikCm9zvKtSfFvjzOoU7a2MrYE2THqcqFclrrO90qU" />}
    {!current && <meta name="msvalidate.01" content="B50580E8CFE687C7E5F89B4C44A75204" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f2ed" />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={url('assets/imagesage-icon.svg')} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
    {preloadPoster && <link rel="preload" as="image" href={url('assets/trailer-poster.jpg')} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ImageSage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="ImageSage Windows app demonstration" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="ImageSage Windows app demonstration" />
    {[pageData, ...structuredData].map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader current={current} />
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
